DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=deos_db
DB_USERNAME=deos_user
DB_PASSWORD=deos_secure_password_2026

DATABASE_URL="postgresql://user:password@localhost:5432/deos_db"

# Cache, Session & Redis Queue Infrastructure
BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=deos_cache_
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

