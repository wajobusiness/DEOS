# DEOS Platform Environment Configuration

# Application Port & Mode
NODE_ENV=production
PORT=3000

# PostgreSQL Database URL (Supabase, Neon, Railway, or AWS RDS)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="deos_super_secure_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Payment Processor Stack (Book 10 §3b)
# Stripe (International Cards)
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Paystack (Nigeria & Africa Card / Bank Transfer)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# Crypto Node / TRC20 Gateway (Book 10 §3a)
TRC20_MASTER_DEPOSIT_ADDRESS="TX9xZgHkM92pqWrtY8dKl9mTRC20Address"

# Platform Constants (Book 0 & Book 4)
MODEL_A_COIN_RATE=1.00 # Fixed utility credit: 1 USD = 1.00 DEOS Coin
PLATFORM_FEE_RATE=0.10 # 10% platform fee
UPLINE_OVERRIDE_RATE=0.03 # 3% upline override
FLAT_BINARY_RATE=0.10 # 10% binary volume commission

