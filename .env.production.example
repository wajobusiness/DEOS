APP_NAME="DEOS Platform"
APP_ENV=production
APP_KEY=base64:cGFzc3dvcmRmb3JkZW9zc2Fhc3N5c3RlbTIwMjYhISE=
APP_DEBUG=false
APP_URL=https://evionaecosystem.com
BASE_DOMAIN=evionaecosystem.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=deos_prod_db
DB_USERNAME=deos_prod_user
DB_PASSWORD=YOUR_STRONG_PROD_DB_PASSWORD_HERE

# Cache & Queues (Redis 7)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# Payment Gateways (Super Admin / Platform Master Rails)
PAYSTACK_PUBLIC_KEY=pk_live_your_live_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_live_paystack_secret_key
PAYSTACK_NGN_RATE=1550.00

CRYPTOMUS_MERCHANT_ID=your_cryptomus_merchant_id
CRYPTOMUS_PAYMENT_KEY=your_cryptomus_payment_key

# Sidecar Scraper Daemon Microservice
SCRAPER_DAEMON_URL=http://127.0.0.1:8080

# Mail Configuration (Transactional Mailer via Resend / AWS SES / Postmark)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=YOUR_RESEND_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@evionaecosystem.com"
MAIL_FROM_NAME="DEOS Platform"
