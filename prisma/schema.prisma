// DEOS Platform PostgreSQL Data Model (Books 0–15)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  launch
  growth
  legacy
}

enum MemberRole {
  member
  admin
  super_admin
  finance
  support
}

enum MemberStatus {
  active
  suspended
  banned
}

enum LedgerEventType {
  direct_referral_bonus
  binary_commission
  generation_bonus
  split_commission_platform
  split_commission_upline
  platform_transaction_fee
  promoter_commission
  product_sale_upline_override
  direct_sale_upline_bonus
  seller_payout
  academy_instructor_revenue
  coin_deposit
  coin_conversion
  wallet_withdrawal
  wallet_transfer_in
  wallet_transfer_out
}

enum OrderStatus {
  pending
  paid
  refunded
  disputed
}

enum KYCStatus {
  pending
  approved
  rejected
}

// ----------------------------------------------------
// 1. Members & Dual-Tree MLM Binary Architecture (Book 4)
// ----------------------------------------------------
model Member {
  id                  String         @id @default(cuid())
  memberCode          String         @unique // e.g. DEOS100245
  name                String
  email               String         @unique
  passwordHash        String
  phone               String?
  country             String?
  avatarUrl           String?
  plan                PlanTier       @default(growth)
  role                MemberRole     @default(member)
  status              MemberStatus   @default(active)
  rank                String         @default("Member")

  // Dual Tree: Sponsor Tree vs Binary Placement Tree (Book 4 §4)
  sponsorId           String?        // Direct referral ancestor (Immutable)
  placementParentId   String?        // Tree placement parent (Binary)
  placementLeg        String?        // "left" or "right"

  // Balances (Model A: Fixed-Value Utility Credit)
  walletBalance       Decimal        @default(0.00) @db.Decimal(12, 2) // In DEOS Coin
  usdtBalance         Decimal        @default(0.00) @db.Decimal(12, 2)
  binaryLeftVolume    Decimal        @default(0.00) @db.Decimal(14, 2)
  binaryRightVolume   Decimal        @default(0.00) @db.Decimal(14, 2)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  renewalDate         DateTime?

  // Relations
  transactions        LedgerTransaction[]
  products            Product[]            @relation("SellerProducts")
  promoterOrders      MarketplaceOrder[]   @relation("PromoterOrders")
  memberOrders        MarketplaceOrder[]   @relation("MemberOrders")
  leads               Lead[]
  site                MemberSite?
  kyc                 KYCVerification?

  @@index([sponsorId])
  @@index([placementParentId])
}

// ----------------------------------------------------
// 2. Append-Only Financial Ledger (Book 0 §14 & Book 4 §15)
// ----------------------------------------------------
model LedgerTransaction {
  id             String          @id @default(cuid())
  memberId       String
  member         Member          @relation(fields: [memberId], references: [id])
  type           LedgerEventType
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("DEOS")
  description    String
  status         String          @default("Completed")
  referenceId    String?         // Order ID, Payout ID, or TX Hash

  createdAt      DateTime        @default(now())

  @@index([memberId])
  @@index([type])
  @@index([createdAt])
}

// ----------------------------------------------------
// 3. Marketplace & Public Guest Commerce (Book 5 v1.3)
// ----------------------------------------------------
model Product {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  title                  String
  category               String
  description            String             @db.Text
  price                  Decimal            @db.Decimal(10, 2) // In DEOS Coin
  affiliateCommissionRate Decimal           @default(0.40) @db.Decimal(4, 2) // 10% to 60%
  sellerId               String
  seller                 Member             @relation("SellerProducts", fields: [sellerId], references: [id])
  imageUrl               String
  digitalFileUrl         String?            // Instant delivery file
  salesCount             Int                @default(0)
  rating                 Decimal            @default(5.0) @db.Decimal(3, 2)
  isActive               Boolean            @default(true)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  orders                 MarketplaceOrderItem[]

  @@index([category])
  @@index([sellerId])
}

model MarketplaceOrder {
  id                     String                 @id @default(cuid())
  orderNumber            String                 @unique // e.g. ORD-982145
  buyerMemberId          String?                // Nullable for Guest Checkout (Book 5 §4a)
  buyerMember            Member?                @relation("MemberOrders", fields: [buyerMemberId], references: [id])
  buyerName              String
  buyerEmail             String
  promoterMemberId       String?                // Referring affiliate ID
  promoterMember         Member?                @relation("PromoterOrders", fields: [promoterMemberId], references: [id])
  
  // Financial Splits (Book 5 §7, §8, §8a)
  totalAmount            Decimal                @db.Decimal(10, 2)
  platformFee            Decimal                @db.Decimal(10, 2)
  promoterCommission     Decimal                @default(0.00) @db.Decimal(10, 2)
  uplineOverride         Decimal                @default(0.00) @db.Decimal(10, 2)
  sellerPayout           Decimal                @db.Decimal(10, 2)

  paymentMethod          String                 // card, usdt_trc20, bank_transfer, deos_wallet
  paymentRail            String                 // stripe, paystack, crypto_direct
  status                 OrderStatus            @default(paid)
  licenseKey             String?                // Instant digital delivery key

  createdAt              DateTime               @default(now())
  items                  MarketplaceOrderItem[]

  @@index([buyerEmail])
  @@index([promoterMemberId])
}

model MarketplaceOrderItem {
  id          String           @id @default(cuid())
  orderId     String
  order       MarketplaceOrder @relation(fields: [orderId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  price       Decimal          @db.Decimal(10, 2)
  quantity    Int              @default(1)
}

// ----------------------------------------------------
// 4. Multi-Tenant Websites & Domains (Book 6)
// ----------------------------------------------------
model MemberSite {
  id              String         @id @default(cuid())
  memberId        String         @unique
  member          Member         @relation(fields: [memberId], references: [id])
  subdomain       String         @unique // e.g. johndoe.deos.com
  customDomain    String?        @unique // e.g. johnsonagency.com
  dnsStatus       String         @default("active")
  sslStatus       String         @default("active")
  contentSchema   Json?          // Versioned layout JSON
  publishedAt     DateTime       @default(now())

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ----------------------------------------------------
// 5. CRM Leads with Immutable Source Attribution (Book 7)
// ----------------------------------------------------
model Lead {
  id              String         @id @default(cuid())
  
  // Ownership & Source Classification (Corporate Lead Architecture)
  leadSource      String         @default("member_landing_page") // company_website, member_landing_page, marketplace, ad_campaign
  ownerType       String         @default("member") // "company" or "member"
  ownerId         String?        // Null for company-owned leads; memberId for member leads
  member          Member?        @relation(fields: [ownerId], references: [id])
  assignedTo      String?        // Staff / Admin ID for sales follow-up
  
  // Contact Details
  name            String
  email           String
  phone           String?
  company         String?
  source          String         // IMMUTABLE source label (e.g. "personal_website", "contact_sales_modal")
  
  // Pipeline & Conversion Tracking
  status          String         @default("new") // new, contacted, qualified, converted, closed
  stage           String         @default("Qualified") // New, Qualified, Proposal, Negotiation, Won, Lost
  dealValue       Decimal?       @db.Decimal(10, 2)
  campaignId      String?
  referralCode    String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerType])
  @@index([ownerId])
  @@index([assignedTo])
  @@index([leadSource])
}

// ----------------------------------------------------
// 6. KYC & Security Audit (Book 10 & Book 13)
// ----------------------------------------------------
model KYCVerification {
  id              String         @id @default(cuid())
  memberId        String         @unique
  member          Member         @relation(fields: [memberId], references: [id])
  documentType    String         // Passport, National ID, Drivers License
  documentNumber  String
  documentUrl     String
  status          KYCStatus      @default(pending)
  verifiedAt      DateTime?

  createdAt       DateTime       @default(now())
}

model AuditLog {
  id              String         @id @default(cuid())
  action          String
  actorId         String
  actorRole       String
  impactCategory  String         // Financial, Tree Placement, System Config
  details         String         @db.Text
  createdAt       DateTime       @default(now())

  @@index([impactCategory])
  @@index([createdAt])
}

